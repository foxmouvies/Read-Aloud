{
  "manifest_version": 3,
  "name": "ReadAloud: PDF & Text Reader",
  "short_name": "ReadAloud",
  "version": "1.0.22",
  "description": "Reads web pages, selected text, PDF files and plain text aloud using your browser's built-in voices. Works in Firefox and Brave/Chromium.",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ReadAloud"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "readaloud@instinct.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "shared/background.js",
    "scripts": [
      "shared/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/right-click-point.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
